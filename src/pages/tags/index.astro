---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/articles';
import { collectTags } from '../../lib/tags';
import { url } from '../../lib/url';

const tags = collectTags(await getArticles());
---

<Base titre="Tous les tags">
  <h1>Tous les tags</h1>
  {tags.length === 0 && <p>Aucun tag pour le moment.</p>}
  <ul class="nuage-tags">
    {
      tags.map((t) => (
        <li>
          <a href={url(`/tags/${t.slug}/`)}>{t.nom}</a> <span class="compte">({t.articles.length})</span>
        </li>
      ))
    }
  </ul>
</Base>
