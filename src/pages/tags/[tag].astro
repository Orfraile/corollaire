---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';
import { collectTags } from '../../lib/tags';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const tags = collectTags(await getArticles());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const n = tag.articles.length;
---

<Base titre={`Tag : ${tag.nom}`}>
  <p><a href={url('/tags/')}>← Tous les tags</a></p>
  <h1>Tag : {tag.nom}</h1>
  <p>{n} article{n > 1 ? 's' : ''}</p>
  {tag.articles.map((article) => <ArticleCard article={article} />)}
</Base>
