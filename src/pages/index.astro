---
import Base from '../layouts/Base.astro';
import ListeArticles from '../components/ListeArticles.astro';
import { getArticles } from '../lib/articles';
import { ARTICLES_PAR_PAGE } from '../lib/config';

const tous = await getArticles();
const totalPages = Math.max(1, Math.ceil(tous.length / ARTICLES_PAR_PAGE));
const articles = tous.slice(0, ARTICLES_PAR_PAGE);
---

<Base>
  <ListeArticles articles={articles} pageCourante={1} totalPages={totalPages} />
</Base>
