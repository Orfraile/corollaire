---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import Media from '../../components/Media.astro';
import Galerie from '../../components/Galerie.astro';
import Fenetre from '../../components/Fenetre.astro';
import Infolettre from '../../components/Infolettre.astro';
import { getArticles, typeLabels, formatDate, extensions } from '../../lib/articles';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const liens = [d.lien, ...d.liens].filter((l): l is string => Boolean(l));
---

<Base
  titre={d.titre}
  description={d.resume}
  currentId={entry.id}
  barreTitre={`${entry.id}.${extensions[d.type]}`}
>
  <article class="article" data-pagefind-body>
    <header>
      <h1>{d.titre}</h1>
      <p class="meta">{formatDate(d.date)} · {typeLabels[d.type]}</p>
      {d.oeuvre && <p class="oeuvre"><em>À propos de : {d.oeuvre}</em></p>}
      <TagList tags={d.tags} />
    </header>

    {liens.map((l) => <Media url={l} />)}

    <div class="texte">
      <Content />
    </div>

    {
      d.photos.length > 0 && (
        <div class="galerie">
          <Galerie photos={d.photos} />
        </div>
      )
    }

    <div class="infolettre-article">
      <Fenetre titre="Recevoir les nouveaux textes">
        <Infolettre suffixe="bas" />
      </Fenetre>
    </div>
  </article>
</Base>
