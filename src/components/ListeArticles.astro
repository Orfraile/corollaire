---
import ArticleCard from './ArticleCard.astro';
import { url } from '../lib/url';

const { articles, pageCourante, totalPages } = Astro.props;
const href = (n: number) => (n === 1 ? url('/') : url(`/page/${n}/`));
const numeros = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<h1>Derniers articles</h1>

{articles.length === 0 && <p>Aucun article pour le moment.</p>}

{articles.map((article) => <ArticleCard article={article} />)}

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {pageCourante > 1 && <a href={href(pageCourante - 1)} rel="prev">← Plus récents</a>}
      <ul>
        {numeros.map((n) => (
          <li>
            <a href={href(n)} aria-current={n === pageCourante ? 'page' : undefined}>
              {n}
            </a>
          </li>
        ))}
      </ul>
      {pageCourante < totalPages && <a href={href(pageCourante + 1)} rel="next">Plus anciens →</a>}
    </nav>
  )
}
